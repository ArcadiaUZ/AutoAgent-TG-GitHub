# MAXFIY — bu faylni hech qachon git'ga qo'shmaydi (cheklang)
# Nusxasini .env deb saqlang va to'ldiring.

# Telegram bot token (@BotFather dan)
TELEGRAM_BOT_TOKEN=

# Kanal (masalan: @my_channel yoki -1001234567890)
TELEGRAM_CHANNEL=

# GitHub PAT (ixtiyoriy — bo'lmasa ../TOKENS.md dan avtomat o'qiladi)
GITHUB_TOKEN=

# GitHub login (ixtiyoriy — bo'lmasa API orqali aniqlanadi)
GITHUB_USER=
